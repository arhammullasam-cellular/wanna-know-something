rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isHost(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return signedIn() && room.hostId == request.auth.uid;
    }

    function isGuest(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return signedIn() && room.guestId == request.auth.uid;
    }

    function isParticipant(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return signedIn() && (
        room.hostId == request.auth.uid ||
        room.guestId == request.auth.uid
      );
    }

    match /rooms/{roomId} {
      // Creating a room: only the authenticated player can create it,
      // and the guest slot must start empty.
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.guestId == null
        && request.resource.data.state == 'waiting';

      // A player who knows a six-character room code may retrieve that
      // single room. Collection-wide listing is explicitly blocked below.
      allow get: if signedIn();
      allow list: if false;

      // The host can control the room/game state.
      // A second player can only claim an empty guest slot, or clear
      // their own guest slot when leaving before/during a session.
      allow update: if signedIn() && (
        resource.data.hostId == request.auth.uid
        || (
          resource.data.guestId == null
          && request.resource.data.guestId == request.auth.uid
          && request.resource.data.hostId == resource.data.hostId
        )
        || (
          resource.data.guestId == request.auth.uid
          && request.resource.data.guestId == null
          && request.resource.data.hostId == resource.data.hostId
        )
      );

      allow delete: if signedIn()
        && resource.data.hostId == request.auth.uid;

      match /messages/{messageId} {
        // Room chat is available only to the two participants.
        allow get, list: if isParticipant(roomId);
        allow create: if isParticipant(roomId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 18
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }

      match /rounds/{roundId} {
        // Only the two participants can read a round.
        allow get, list: if isParticipant(roomId);

        // Only the host creates new rounds.
        allow create: if isHost(roomId);

        // Both participants may update round gameplay fields such as
        // submittedUids, skippedBy and reactions.
        allow update: if isParticipant(roomId);

        allow delete: if isHost(roomId);

        match /answers/{answerUid} {
          // A player can write only their own answer.
          allow create, update: if isParticipant(roomId)
            && request.auth.uid == answerUid;

          // Answers remain private until the room reaches reveal/finished.
          // The player can always read their own answer.
          allow get: if isParticipant(roomId) && (
            request.auth.uid == answerUid
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.state in ['reveal', 'finished']
          );

          // We never need collection-wide answer queries.
          allow list: if false;

          allow delete: if isParticipant(roomId)
            && request.auth.uid == answerUid;
        }
      }
    }
  }
}
