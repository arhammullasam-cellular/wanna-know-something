rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function participant(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return signedIn() && (room.hostId == request.auth.uid || room.guestId == request.auth.uid);
    }
    function host(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return signedIn() && room.hostId == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.guestId == null;

      // A room with an empty guest slot must be readable so a player who knows the code can join.
      allow read: if signedIn()
        && (resource.data.guestId == null
          || resource.data.hostId == request.auth.uid
          || resource.data.guestId == request.auth.uid);

      // Joining is restricted to filling the currently empty guest slot. Participants may update
      // room state and gameplay metadata afterward.
      allow update: if signedIn() && (
        (resource.data.hostId == request.auth.uid)
        || (resource.data.guestId == request.auth.uid)
        || (resource.data.guestId == null && request.resource.data.guestId == request.auth.uid)
      );

      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;

      match /rounds/{roundId} {
        allow read: if participant(roomId);
        allow create: if host(roomId);
        allow update: if participant(roomId);
        allow delete: if host(roomId);

        match /answers/{answerUid} {
          // Each player can create/update only their own answer.
          allow create, update: if participant(roomId) && request.auth.uid == answerUid;

          // Answers stay private until the room reaches reveal/finished state.
          allow read: if participant(roomId) && (
            request.auth.uid == answerUid
            || get(/databases/$(database)/documents/rooms/$(roomId)).data.state in ['reveal', 'finished']
          );

          allow delete: if participant(roomId) && request.auth.uid == answerUid;
        }
      }
    }
  }
}
